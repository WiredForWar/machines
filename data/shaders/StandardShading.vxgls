#version 310 es

precision mediump float;
// Input vertex data, different for all executions of this shader.
in vec3 vertexPosition_modelspace;
in vec2 vertexUV;
in vec4 vertexColor;
in vec3 vertexNormal;

// Output data ; will be interpolated for each fragment.
out vec2 UV;
out vec4 fragmentColor;
out vec4 viewSpace;
out vec4 fragmentFogColour;
out vec3 fragmentFogParams;

// Values that stay constant for the whole mesh.
uniform mat4 uM;
uniform mat4 uV;
uniform mat4 uP;
uniform vec3 uFogColour;
uniform vec3 uFogParams;

// GPU lighting uniforms
uniform int uGpuLighting;
uniform vec3 uLightDir;
uniform vec3 uLightColor;
uniform vec3 uAmbientColor;
uniform vec3 uMatDiffuse;
uniform vec3 uMatAmbient;
uniform vec3 uMatEmissive;

void main() {

	// Output position of the vertex, in clip space : MVP * position
    mat4 MVP = uP * uV * uM;
	gl_Position =  MVP * vec4(vertexPosition_modelspace,1);
	
	// UV of the vertex. No special space for this one.
    UV = vertexUV;

    if (uGpuLighting != 0)
    {
        // Transform normal to world space (using upper-left 3x3 of model matrix)
        vec3 worldNormal = normalize(mat3(uM) * vertexNormal);

        // Lambertian diffuse: max(dot(N, -lightDir), 0)
        float NdotL = max(dot(worldNormal, -uLightDir), 0.0);
        vec3 lambertian = NdotL * uLightColor;

        // Match CPU formula: finalColor = lambertian * matDiffuse + sceneAmbient * matAmbient + matEmissive
        vec3 lit = lambertian * uMatDiffuse + uAmbientColor * uMatAmbient + uMatEmissive;
        fragmentColor = vec4(lit, 1.0);
    }
    else
    {
        fragmentColor = vec4(vertexColor[2],vertexColor[1],vertexColor[0],vertexColor[3]);
    }

    viewSpace = uV * uM * vec4(vertexPosition_modelspace,1); 
    fragmentFogColour = vec4(uFogColour,1);
    fragmentFogParams = uFogParams;
}

