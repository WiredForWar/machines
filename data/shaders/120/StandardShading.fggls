#version 120

// Interpolated values from the vertex shaders
varying vec2 UV;
varying vec4 fragmentColor;
varying vec3 fragWorldNormal;
varying vec3 fragVtxDiffuse;
varying vec3 fragVtxAmbient;
varying vec3 fragVtxEmissive;
varying vec3 fragWorldPos;
varying vec4 viewSpace;

// Values that stay constant for the whole mesh.
uniform sampler2D uTextureSampler2;
uniform vec3 uFogColour;
uniform vec3 uFogParams;
uniform int uFogMode;

// Per-pixel lighting uniforms
uniform int uGpuLighting;
uniform vec3 uLightDir;
uniform vec3 uLightColor;
uniform vec3 uAmbientColor;
uniform vec3 uMatDiffuse;
uniform float uMatDiffuseA;
uniform vec3 uMatAmbient;
uniform vec3 uMatEmissive;
uniform vec3 uFilter;
uniform int uHasVtxMaterials;

const int MAX_POINT_LIGHTS = 16;
uniform int uNumPointLights;
uniform vec3 uPointLightPos[MAX_POINT_LIGHTS];
uniform vec3 uPointLightColor[MAX_POINT_LIGHTS];
uniform float uPointLightRange[MAX_POINT_LIGHTS];
uniform vec3 uPointLightAtten[MAX_POINT_LIGHTS]; // (constant, linear, quadratic)
uniform float uPointLightOmni[MAX_POINT_LIGHTS]; // 1.0 = omnidirectional, 0.0 = normal

// Shadow mapping (cascaded shadow maps)
uniform sampler2D uShadowMap;          // far cascade
uniform mat4 uLightSpaceMatrix;        // far cascade
uniform sampler2D uShadowMapNear;      // near cascade
uniform mat4 uLightSpaceMatrixNear;    // near cascade
uniform float uShadowSplitDistance;
uniform int uShadowEnabled;
uniform float uShadowStrength;

float sampleShadowPCF(sampler2D shadowMap, vec3 projCoords, float bias, float texelSize)
{
    float currentDepth = projCoords.z;
    float shadow = 0.0;
    for (int x = -2; x <= 2; ++x)
    {
        for (int y = -2; y <= 2; ++y)
        {
            float pcfDepth = texture2D(shadowMap, projCoords.xy + vec2(float(x), float(y)) * texelSize).r;
            shadow += (currentDepth - bias > pcfDepth) ? 1.0 : 0.0;
        }
    }
    return shadow / 25.0;
}

float calcShadow(vec3 worldPos, vec3 normal, vec3 lightDir, float viewDist)
{
    float NdotL = dot(normal, -lightDir);

    // Surfaces facing away from the light are in self-shadow by definition.
    if (NdotL <= 0.0)
        return 1.0;

    // Smooth transition zone: for surfaces nearly edge-on to the light
    // (NdotL 0..0.3), blend between full shadow and the shadow map result.
    // This hides staircase artifacts on steep surfaces (e.g. cliff faces
    // with a moving sun) by gradually fading out the shadow map influence.
    float edgeFade = smoothstep(0.0, 0.3, NdotL);

    // Slope-scaled depth bias.
    float bias = max(0.008 * (1.0 - NdotL), 0.002);

    float shadowSample = 0.0;

    // Far cascade — always computed as a fallback / cross-check.
    float farShadow = 0.0;
    {
        vec4 lsPos = uLightSpaceMatrix * vec4(worldPos, 1.0);
        vec3 projCoords = lsPos.xyz / lsPos.w * 0.5 + 0.5;
        if (projCoords.x >= 0.0 && projCoords.x <= 1.0 &&
            projCoords.y >= 0.0 && projCoords.y <= 1.0 &&
            projCoords.z <= 1.0)
        {
            farShadow = sampleShadowPCF(uShadowMap, projCoords, bias, 1.0 / 2048.0);
        }
    }

    // Try near cascade — it wins whenever the fragment is inside
    // its light-space projection bounds.  Because the near cascade
    // has a small extent, tall shadow casters (cliffs) may fall
    // outside its ortho box.  Cross-check with the far cascade so
    // those missing shadows are filled in.
    {
        vec4 lsPos = uLightSpaceMatrixNear * vec4(worldPos, 1.0);
        vec3 projCoords = lsPos.xyz / lsPos.w * 0.5 + 0.5;
        if (projCoords.x >= 0.0 && projCoords.x <= 1.0 &&
            projCoords.y >= 0.0 && projCoords.y <= 1.0 &&
            projCoords.z >= 0.0 && projCoords.z <= 1.0)
        {
            float nearShadow = sampleShadowPCF(uShadowMapNear, projCoords, bias, 1.0 / 4096.0);
            shadowSample = max(nearShadow, farShadow);
            return mix(1.0, shadowSample, edgeFade);
        }
    }

    shadowSample = farShadow;
    return mix(1.0, shadowSample, edgeFade);
}

void main() {
    
    // Per-pixel fog
    float viewDist = length(viewSpace);
    float fogFactor = 0.0;

    // fogEnd > 0 indicates that fog is turned on
    if (uFogParams[1] > 0.0)
    {
        if (uFogMode == 1)
        {
            // Exponential squared fog
            float density = uFogParams[2];
            float dd = density * viewDist;
            fogFactor = 1.0 - exp(-dd * dd);
        }
        else
        {
            // Linear fog (mode 0, default)
            float fogStart = uFogParams[0];
            float fogEnd = uFogParams[1];
            fogFactor = (fogStart - viewDist) / (fogStart - fogEnd);
        }
        fogFactor = clamp(fogFactor, 0.0, 1.0);
    }

    vec4 litColor;
    if (uGpuLighting == 1)
    {
        // Per-pixel lighting: re-normalize interpolated normal and compute Lambertian
        vec3 N = normalize(fragWorldNormal);
        vec3 L = normalize(uLightDir);
        float NdotL = max(dot(N, -L), 0.0);
        vec3 lambertian = NdotL * uLightColor;

        // Use per-vertex material if available; sentinel -1 means use group material uniform
        vec3 diffuse = (uHasVtxMaterials == 1 && fragVtxDiffuse.r >= 0.0) ? fragVtxDiffuse : uMatDiffuse;
        vec3 ambient = (uHasVtxMaterials == 1 && fragVtxAmbient.r >= 0.0) ? fragVtxAmbient : uMatAmbient;

        // Point lights
        vec3 pointLightContrib = vec3(0.0);
        for (int i = 0; i < MAX_POINT_LIGHTS; ++i)
        {
            if (i >= uNumPointLights) break;
            vec3 toLight = uPointLightPos[i] - fragWorldPos;
            float dist = length(toLight);
            if (dist >= uPointLightRange[i]) continue;
            float normalised = 1.0 - dist / uPointLightRange[i];
            float att = uPointLightAtten[i].x + uPointLightAtten[i].y * normalised + uPointLightAtten[i].z * normalised * normalised;
            vec3 Lp = normalize(toLight);
            float NdotLp = mix(max(dot(N, Lp), 0.0), 1.0, uPointLightOmni[i]);
            pointLightContrib += att * NdotLp * uPointLightColor[i];
        }

        vec3 emissive = (uHasVtxMaterials == 1 && fragVtxEmissive.r >= 0.0) ? fragVtxEmissive : uMatEmissive;

        float shadow = 0.0;
        if (uShadowEnabled == 1)
            shadow = calcShadow(fragWorldPos, N, L, viewDist) * uShadowStrength;

        vec3 lit = uFilter * ((1.0 - shadow) * lambertian * diffuse + uAmbientColor * ambient + emissive + pointLightContrib * diffuse);
        litColor = vec4(clamp(lit, 0.0, 1.0), uMatDiffuseA);
    }
    else
    {
        // Legacy (CPU-lit vertex color) or debug modes (already computed in vertex shader)
        litColor = fragmentColor;
    }

	// Output color = color of the texture at the specified UV
    gl_FragColor = texture2D( uTextureSampler2, UV ) * litColor;
    
    //Appy fog, if you inverse color in glsl mix function you have to
    //put 1.0 - fogFactor    
    float alpha = gl_FragColor[3];
    gl_FragColor = gl_FragColor * (1.0 - fogFactor) + vec4(uFogColour, 1.0) * fogFactor;
    gl_FragColor[3] = alpha;
}
