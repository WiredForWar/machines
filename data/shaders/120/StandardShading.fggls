#version 120

// Uncomment to visualize shadow cascade coverage (red=near, blue=far).
//#define DEBUG_CASCADES

// Interpolated values from the vertex shaders
varying vec2 UV;
varying vec4 fragmentColor;
varying vec3 fragWorldNormal;
varying vec3 fragVtxDiffuse;
varying vec3 fragVtxAmbient;
varying vec3 fragVtxEmissive;
varying vec3 fragWorldPos;
varying vec4 viewSpace;

// Values that stay constant for the whole mesh.
uniform sampler2D uTextureSampler2;
uniform vec3 uFogColour;
uniform vec3 uFogParams;
uniform int uFogMode;

// Per-pixel lighting uniforms
uniform int uGpuLighting;
uniform vec3 uLightDir;
uniform vec3 uLightColor;
uniform vec3 uAmbientColor;
uniform vec3 uMatDiffuse;
uniform float uMatDiffuseA;
uniform vec3 uMatAmbient;
uniform vec3 uMatEmissive;
uniform vec3 uFilter;
uniform int uHasVtxMaterials;

const int MAX_POINT_LIGHTS = 16;
uniform int uNumPointLights;
uniform vec3 uPointLightPos[MAX_POINT_LIGHTS];
uniform vec3 uPointLightColor[MAX_POINT_LIGHTS];
uniform float uPointLightRange[MAX_POINT_LIGHTS];
uniform vec3 uPointLightAtten[MAX_POINT_LIGHTS]; // (constant, linear, quadratic)
uniform float uPointLightOmni[MAX_POINT_LIGHTS]; // 1.0 = omnidirectional, 0.0 = normal

// Shadow mapping (cascaded shadow maps)
uniform sampler2D uShadowMap;          // far cascade
uniform mat4 uLightSpaceMatrix;        // far cascade
uniform sampler2D uShadowMapNear;      // near cascade
uniform mat4 uLightSpaceMatrixNear;    // near cascade
uniform int uShadowEnabled;
uniform float uShadowStrength;
uniform int uShadowFilterTaps;

// The depth comparison happens in the cascade's normalised [0,1] range, but the
// offset a surface needs is a world distance: about the ground one shadow texel
// covers, tilted by the angle between the surface and the light. Both scales are
// in the light matrix already, so deriving them here makes the bias follow
// whichever cascade is being sampled rather than being tuned for one of them and
// wrong by an order of magnitude in the others.
//
//   |row 0| = 1 / ortho extent  ->  a texel spans 2 * texelSize / |row 0| metres
//   |row 2| = 2 / (far - near)  ->  unit normalised depth spans 2 / |row 2| metres
//
// Rows, not columns: m[i] indexes a column in GLSL.
float shadowBias(mat4 lightMatrix, float texelSize, float NdotL)
{
    vec3 xRow = vec3(lightMatrix[0][0], lightMatrix[1][0], lightMatrix[2][0]);
    vec3 zRow = vec3(lightMatrix[0][2], lightMatrix[1][2], lightMatrix[2][2]);

    float metresPerTexel = 2.0 * texelSize / length(xRow);
    float metresPerDepth = 2.0 / length(zRow);

    // Tangent of the angle away from the light. Clamped, because a surface seen
    // edge-on would otherwise ask for an unbounded offset and peter-pan instead.
    float slope = sqrt(max(1.0 - NdotL * NdotL, 0.0)) / max(NdotL, 0.15);

    return metresPerTexel * (1.0 + 2.0 * min(slope, 5.0)) / metresPerDepth;
}

float sampleShadowPCF(sampler2D shadowMap, vec3 projCoords, float bias, float texelSize)
{
    float currentDepth = projCoords.z;

    // A single sample costs 25 times fewer texture fetches, and the filter
    // is per fragment over the whole screen, so this dominates the cost of
    // a shadowed frame.
    if (uShadowFilterTaps <= 1)
    {
        float centreDepth = texture2D(shadowMap, projCoords.xy).r;
        return (currentDepth - bias > centreDepth) ? 1.0 : 0.0;
    }

    float shadow = 0.0;
    for (int x = -2; x <= 2; ++x)
    {
        for (int y = -2; y <= 2; ++y)
        {
            float pcfDepth = texture2D(shadowMap, projCoords.xy + vec2(float(x), float(y)) * texelSize).r;
            shadow += (currentDepth - bias > pcfDepth) ? 1.0 : 0.0;
        }
    }
    return shadow / 25.0;
}

#ifdef DEBUG_CASCADES
vec4 debugColor;
#endif

float calcShadow(vec3 worldPos, vec3 normal, vec3 lightDir, float viewDist)
{
#ifdef DEBUG_CASCADES
    debugColor = vec4(0.0);
#endif

    float NdotL = dot(normal, -lightDir);

    // Surfaces facing away from the light are in self-shadow by definition.
    if (NdotL <= 0.0)
        return 1.0;

    // Each cascade has its own texel footprint and its own ortho depth range, so
    // the bias has to be worked out per cascade -- see shadowBias().
    const float nearTexel = 1.0 / 4096.0;
    const float farTexel = 1.0 / 2048.0;

    float shadowSample = 0.0;

    // Near cascade coverage check.
    vec4 nearLsPos = uLightSpaceMatrixNear * vec4(worldPos, 1.0);
    vec3 nearProj = nearLsPos.xyz / nearLsPos.w * 0.5 + 0.5;
    bool inNear = nearProj.x >= 0.0 && nearProj.x <= 1.0 &&
        nearProj.y >= 0.0 && nearProj.y <= 1.0 &&
        nearProj.z >= 0.0 && nearProj.z <= 1.0;

    // Far cascade coverage check.
    vec4 farLsPos = uLightSpaceMatrix * vec4(worldPos, 1.0);
    vec3 farProj = farLsPos.xyz / farLsPos.w * 0.5 + 0.5;
    bool inFar = farProj.x >= 0.0 && farProj.x <= 1.0 &&
        farProj.y >= 0.0 && farProj.y <= 1.0 &&
        farProj.z <= 1.0;

    // Always sample the far cascade when available (used as cross-check).
    float farShadow = 0.0;
    if (inFar)
        farShadow = sampleShadowPCF(
            uShadowMap, farProj, shadowBias(uLightSpaceMatrix, farTexel, NdotL), farTexel);

    if (inNear)
    {
#ifdef DEBUG_CASCADES
        float d = length(nearProj.xy - vec2(0.5)) / 0.5;
        float center = 1.0 - smoothstep(0.0, 0.05, d);
        float edge = smoothstep(0.92, 0.96, d) * (1.0 - smoothstep(0.96, 1.0, d));
        float fill = 0.4 * (1.0 - d);
        float intensity = max(max(center, edge), fill);
        debugColor = vec4(intensity, intensity * 0.15, intensity * 0.15, 1.0);
#endif
        // Use the sharp near cascade for the inner region.  Only blend
        // in the (blurrier) far cascade near the edges of the near
        // cascade's coverage where tall casters may fall outside its
        // small ortho box.  This keeps shadows crisp at the player's
        // visual focus while still filling in missing casters at the
        // periphery.
        float nearShadow = sampleShadowPCF(
            uShadowMapNear, nearProj, shadowBias(uLightSpaceMatrixNear, nearTexel, NdotL), nearTexel);
        float nearEdge = max(abs(nearProj.x - 0.5), abs(nearProj.y - 0.5)) * 2.0; // 0..1
        float blendFar = smoothstep(0.8, 1.0, nearEdge);
        shadowSample = mix(nearShadow, max(nearShadow, farShadow), blendFar);
        return shadowSample;
    }
    else if (inFar)
    {
#ifdef DEBUG_CASCADES
        float d = length(farProj.xy - vec2(0.5)) / 0.5;
        float center = 1.0 - smoothstep(0.0, 0.05, d);
        float edge = smoothstep(0.92, 0.96, d) * (1.0 - smoothstep(0.96, 1.0, d));
        float fill = 0.4 * (1.0 - d);
        float intensity = max(max(center, edge), fill);
        debugColor = vec4(intensity * 0.15, intensity * 0.15, intensity, 1.0);
#endif
        shadowSample = farShadow;
        return shadowSample;
    }

    return 0.0;
}

void main() {
    
    // Per-pixel fog
    float viewDist = length(viewSpace);
    float fogFactor = 0.0;

    // fogEnd > 0 indicates that fog is turned on
    if (uFogParams[1] > 0.0)
    {
        if (uFogMode == 1)
        {
            // Exponential squared fog
            float density = uFogParams[2];
            float dd = density * viewDist;
            fogFactor = 1.0 - exp(-dd * dd);
        }
        else
        {
            // Linear fog (mode 0, default)
            float fogStart = uFogParams[0];
            float fogEnd = uFogParams[1];
            fogFactor = (fogStart - viewDist) / (fogStart - fogEnd);
        }
        fogFactor = clamp(fogFactor, 0.0, 1.0);
    }

    vec4 litColor;
    if (uGpuLighting == 1)
    {
        // Per-pixel lighting: re-normalize interpolated normal and compute Lambertian
        vec3 N = normalize(fragWorldNormal);
        vec3 L = normalize(uLightDir);
        float NdotL = max(dot(N, -L), 0.0);
        vec3 lambertian = NdotL * uLightColor;

        // Use per-vertex material if available; sentinel -1 means use group material uniform
        vec3 diffuse = (uHasVtxMaterials == 1 && fragVtxDiffuse.r >= 0.0) ? fragVtxDiffuse : uMatDiffuse;
        vec3 ambient = (uHasVtxMaterials == 1 && fragVtxAmbient.r >= 0.0) ? fragVtxAmbient : uMatAmbient;

        // Point lights
        vec3 pointLightContrib = vec3(0.0);
        for (int i = 0; i < MAX_POINT_LIGHTS; ++i)
        {
            if (i >= uNumPointLights) break;
            vec3 toLight = uPointLightPos[i] - fragWorldPos;
            float dist = length(toLight);
            if (dist >= uPointLightRange[i]) continue;
            float normalised = 1.0 - dist / uPointLightRange[i];
            float att = uPointLightAtten[i].x + uPointLightAtten[i].y * normalised + uPointLightAtten[i].z * normalised * normalised;
            vec3 Lp = normalize(toLight);
            float NdotLp = mix(max(dot(N, Lp), 0.0), 1.0, uPointLightOmni[i]);
            pointLightContrib += att * NdotLp * uPointLightColor[i];
        }

        vec3 emissive = (uHasVtxMaterials == 1 && fragVtxEmissive.r >= 0.0) ? fragVtxEmissive : uMatEmissive;

        float shadow = 0.0;
        if (uShadowEnabled == 1)
            shadow = calcShadow(fragWorldPos, N, L, viewDist) * uShadowStrength;

        vec3 lit = uFilter * ((1.0 - shadow) * lambertian * diffuse + uAmbientColor * ambient + emissive + pointLightContrib * diffuse);
        litColor = vec4(clamp(lit, 0.0, 1.0), uMatDiffuseA);
#ifdef DEBUG_CASCADES
        if (debugColor.a > 0.0)
            litColor = vec4(mix(litColor.rgb, debugColor.rgb, 0.85), 1.0);
#endif
    }
    else
    {
        // Legacy (CPU-lit vertex color) or debug modes (already computed in vertex shader)
        litColor = fragmentColor;
    }

	// Output color = color of the texture at the specified UV
    gl_FragColor = texture2D( uTextureSampler2, UV ) * litColor;
    
    //Appy fog, if you inverse color in glsl mix function you have to
    //put 1.0 - fogFactor    
    float alpha = gl_FragColor[3];
    gl_FragColor = gl_FragColor * (1.0 - fogFactor) + vec4(uFogColour, 1.0) * fogFactor;
    gl_FragColor[3] = alpha;
}
